{% comment %}
  Shopify COD Quick Buy Button & Modal Block
  ──────────────────────────────────────────
  - Scoped Theme App Extension Block (target: section)
  - Loads CSS/JS from Shopify Extension Assets CDN
  - Passes Shopify Liquid product, variant, and store context dynamically
  - 100% Theme Independent
{% endcomment %}

{{ 'bootstrap-icons.css' | asset_url | stylesheet_tag }}
{{ 'cod-modal.css'       | asset_url | stylesheet_tag }}

<script>
  window.COD_APP_API_BASE = {{ app.url | json }};
  window.COD_SHOP_DOMAIN  = {{ shop.permanent_domain | json }};
  window.COD_SHOP_NAME    = {{ shop.name | json }};
</script>

{%- assign selected_variant = product.selected_or_first_available_variant -%}
{%- assign featured_img = product.featured_image | default: product.images.first -%}

<div
  class="cod-button-wrapper"
  style="margin: {{ block.settings.margin_top | default: 10 }}px 0 {{ block.settings.margin_bottom | default: 10 }}px;"
  {{ block.shopify_attributes }}
>
  <button
    type="button"
    class="cod-trigger-btn"
    id="cod-app-buy-now-btn"
    data-cod-trigger
    data-product-title="{{ product.title | escape }}"
    data-product-id="{{ product.id }}"
    data-variant-id="{{ selected_variant.id }}"
    data-variant-title="{{ selected_variant.title | escape }}"
    data-product-price="{{ selected_variant.price | divided_by: 100.0 }}"
    data-product-image="{{ featured_img | img_url: '300x300' }}"
    data-product-quantity="1"
    data-shop-name="{{ shop.name | escape }}"
    style="
      background: {{ block.settings.btn_color | default: '#108043' }};
      color: {{ block.settings.btn_text_color | default: '#ffffff' }};
      border-radius: {{ block.settings.border_radius | default: 12 }}px;
    "
  >
    <i class="bi bi-cash-coin" style="margin-right: 6px;"></i>
    <span>{{ block.settings.button_label | default: 'Buy with COD' }}</span>
  </button>
</div>

<script src="{{ 'cod-modal.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "COD Buy Button",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Buy with COD"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button Background Color",
      "default": "#108043"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Border Radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Margin Top",
      "default": 10
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom",
      "default": 10
    }
  ]
}
{% endschema %}