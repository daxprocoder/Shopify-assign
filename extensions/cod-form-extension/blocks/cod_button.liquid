{% comment %}
  Shopify COD Quick Buy Button & Modal Block
{% endcomment %}

{{ 'https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css' | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'cod-modal.css' | asset_url }}">

<div class="cod-button-wrapper" style="margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px;">
  <button
    type="button"
    class="cod-trigger-btn"
    data-cod-trigger
    data-product-title="{{ product.title | escape }}"
    data-product-price="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}"
    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
    data-product-quantity="1"
    style="background: {{ block.settings.btn_color }}; color: {{ block.settings.btn_text_color }}; border-radius: {{ block.settings.border_radius }}px;"
  >
    <span>{{ block.settings.button_label | default: '⚡ Buy with Cash on Delivery (COD)' }}</span>
  </button>
</div>

<script src="{{ 'cod-modal.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "COD Quick Buy Button",
  "target": "section",
  "stylesheet": "cod-modal.css",
  "javascript": "cod-modal.js",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "⚡ Buy with Cash on Delivery (COD)"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button Background Color",
      "default": "#108043"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Border Radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Margin Top",
      "default": 10
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom",
      "default": 10
    }
  ]
}
{% endschema %}
